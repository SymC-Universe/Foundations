      "NOMINAL_FUNCTION",
      "PERTURBED_FUNCTION",
      "ALTERNATE_STABLE_ORGANIZATION",
      "BOUNDARY_OR_TRANSITION",
      "POST_TRANSITION_OR_FAILURE",
      "RARE_NATURAL_LIMIT",
      "UNRESOLVED"
    ],
    "architecture": {
